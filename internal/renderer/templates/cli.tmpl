// {{$prefix}}GoFieldName mirrors protoc-gen-go's snake_case -> UpperCamel
// conversion for reflective struct-field lookup.
func {{$prefix}}GoFieldName(snake string) string {
	if snake == "" {
		return ""
	}
	upperNext := true
	out := make([]rune, 0, len(snake))
	for _, r := range snake {
		if r == '_' {
			upperNext = true
			continue
		}
		if upperNext {
			if r >= 'a' && r <= 'z' {
				r -= 'a' - 'A'
			}
			upperNext = false
		}
		out = append(out, r)
	}
	return string(out)
}
