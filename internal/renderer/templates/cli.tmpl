// {{$prefix}}TimestampValue is a pflag.Value parsing RFC3339 / RFC3339Nano
// into a *timestamppb.Timestamp. Empty input is an error; callers
// presence-gate via cmd.Flags().Changed.
type {{$prefix}}TimestampValue struct {
	ts *{{Timestamppb "Timestamp"}}
}

func (v *{{$prefix}}TimestampValue) Set(s string) error {
	t, err := {{Time "Parse"}}({{Time "RFC3339Nano"}}, s)
	if err != nil {
		t, err = {{Time "Parse"}}({{Time "RFC3339"}}, s)
		if err != nil {
			return {{Fmt "Errorf"}}("invalid RFC3339 timestamp %q: %w", s, err)
		}
	}
	v.ts = {{Timestamppb "New"}}(t)
	return nil
}

func (v *{{$prefix}}TimestampValue) String() string {
	if v == nil || v.ts == nil {
		return ""
	}
	return v.ts.AsTime().Format({{Time "RFC3339Nano"}})
}

func (v *{{$prefix}}TimestampValue) Type() string { return "timestamp" }

// {{$prefix}}OverlapValue is a pflag.Value for the schedule overlap
// policy. Value names are kebab-case; Set is case-insensitive.
type {{$prefix}}OverlapValue struct {
	v   {{Enumspb "ScheduleOverlapPolicy"}}
	set bool
}

func (v *{{$prefix}}OverlapValue) Set(s string) error {
	switch {{Strings "ToLower"}}(s) {
	case "skip":
		v.v = {{Enumspb "SCHEDULE_OVERLAP_POLICY_SKIP"}}
	case "buffer-one":
		v.v = {{Enumspb "SCHEDULE_OVERLAP_POLICY_BUFFER_ONE"}}
	case "buffer-all":
		v.v = {{Enumspb "SCHEDULE_OVERLAP_POLICY_BUFFER_ALL"}}
	case "cancel-other":
		v.v = {{Enumspb "SCHEDULE_OVERLAP_POLICY_CANCEL_OTHER"}}
	case "terminate-other":
		v.v = {{Enumspb "SCHEDULE_OVERLAP_POLICY_TERMINATE_OTHER"}}
	case "allow-all":
		v.v = {{Enumspb "SCHEDULE_OVERLAP_POLICY_ALLOW_ALL"}}
	default:
		return {{Fmt "Errorf"}}("invalid overlap %q; want one of: skip, buffer-one, buffer-all, cancel-other, terminate-other, allow-all", s)
