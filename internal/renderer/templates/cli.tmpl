{{- /*
CLI template - generates a Cobra-based CLI for the service. Sections:
  1. Entry point + subgroups (workflow, schedule).
  2. Per-workflow commands: start, execute, signal*, query*, schedule-create.
  3. Cross-workflow commands: cancel, terminate, describe.
  4. Schedule group: pause, unpause, delete, describe.
  5. Shared pflag.Value types (timestamp, overlap, enum-per-type, JSON).
  6. Reflection-based setter helpers + JSON unmarshal shim.

Shared helper identifiers are service-prefixed (e.g. <GoName>cliXxx) so
multiple services in the same package do not collide.
*/ -}}

{{- $svc := . -}}
{{- $svcKebab := .GoName | kebab -}}
{{- $prefix := printf "%scli" .GoName -}}

// New{{.GoName}}CLI returns the root cobra command wiring every generated
// command for the {{.GoName}} service. The caller constructs the temporal
// client and adds the returned command under its own root.
func New{{.GoName}}CLI(c {{TemporalClient "Client"}}) *{{Cobra "Command"}} {
	root := &{{Cobra "Command"}}{
		Use:   {{Quote $svcKebab}},
		Short: "CLI for {{.GoName}} workflows and schedules",
	}
	root.AddCommand({{$prefix}}NewWorkflowGroup(c))
	root.AddCommand({{$prefix}}NewScheduleGroup(c))
	return root
}

// {{$prefix}}NewWorkflowGroup assembles the `workflow` subcommand tree:
// `workflow start/execute/signal/query <workflow-name>` plus the
// workflow-id targeted helpers (cancel, terminate, describe). Per
// PLAN.md §3.2 start/execute are themselves groups with one subcommand
// per workflow; signal and query additionally nest the signal/query
// name under the workflow's subcommand.
func {{$prefix}}NewWorkflowGroup(c {{TemporalClient "Client"}}) *{{Cobra "Command"}} {
	cmd := &{{Cobra "Command"}}{
		Use:   "workflow",
		Short: "Workflow operations",
	}
	start := &{{Cobra "Command"}}{Use: "start", Short: "Start a workflow"}
	execute := &{{Cobra "Command"}}{Use: "execute", Short: "Execute a workflow and wait for the result"}
	signal := &{{Cobra "Command"}}{Use: "signal", Short: "Send a signal to a running workflow"}
	query := &{{Cobra "Command"}}{Use: "query", Short: "Query a running workflow"}
{{- range .Workflows}}
{{- if .InputFlagPlan}}
{{- $wf := .}}
{{- $wfKebab := .GoName | kebab}}
	start.AddCommand({{$prefix}}New{{.GoName}}StartCmd(c))
	execute.AddCommand({{$prefix}}New{{.GoName}}ExecuteCmd(c))
{{- $sigGroup := printf "%sSignalGroup" $wfKebab -}}
{{- $anySig := false -}}
{{- range .Options.Signals -}}
{{- $sig := index $svc.SignalsMap . -}}
{{- if $sig -}}
{{- $anySig = true -}}
{{- end -}}
{{- end}}
{{- if $anySig}}
	{{printf "sig%s" $wf.GoName}} := &{{Cobra "Command"}}{Use: {{Quote $wfKebab}}, Short: "Signals for workflow {{$wf.GoName}}"}
{{- range .Options.Signals}}
{{- $sig := index $svc.SignalsMap .}}
{{- if $sig}}
	{{printf "sig%s" $wf.GoName}}.AddCommand({{$prefix}}New{{$wf.GoName}}Signal{{$sig.GoName}}Cmd(c))
{{- end}}
{{- end}}
	signal.AddCommand({{printf "sig%s" $wf.GoName}})
{{- end}}
{{- $anyQ := false -}}
{{- range .Options.Queries -}}
{{- $q := index $svc.QueriesMap . -}}
{{- if $q -}}
{{- $anyQ = true -}}
{{- end -}}
{{- end}}
{{- if $anyQ}}
	{{printf "q%s" $wf.GoName}} := &{{Cobra "Command"}}{Use: {{Quote $wfKebab}}, Short: "Queries for workflow {{$wf.GoName}}"}
{{- range .Options.Queries}}
{{- $q := index $svc.QueriesMap .}}
{{- if $q}}
	{{printf "q%s" $wf.GoName}}.AddCommand({{$prefix}}New{{$wf.GoName}}Query{{$q.GoName}}Cmd(c))
{{- end}}
{{- end}}
	query.AddCommand({{printf "q%s" $wf.GoName}})
{{- end}}
{{- end}}
{{- end}}
	cmd.AddCommand(start)
	cmd.AddCommand(execute)
	cmd.AddCommand(signal)
	cmd.AddCommand(query)
	cmd.AddCommand({{$prefix}}NewCancelCmd(c))
	cmd.AddCommand({{$prefix}}NewTerminateCmd(c))
	cmd.AddCommand({{$prefix}}NewDescribeCmd(c))
	return cmd
}

// {{$prefix}}NewScheduleGroup assembles the `schedule` subcommand tree.
func {{$prefix}}NewScheduleGroup(c {{TemporalClient "Client"}}) *{{Cobra "Command"}} {
	cmd := &{{Cobra "Command"}}{
		Use:   "schedule",
		Short: "Schedule operations",
	}
	create := &{{Cobra "Command"}}{
		Use:   "create",
		Short: "Create a schedule for a workflow",
	}
{{- range .Workflows}}
{{- if .InputFlagPlan}}
	create.AddCommand({{$prefix}}New{{.GoName}}ScheduleCreateCmd(c))
{{- end}}
{{- end}}
	cmd.AddCommand(create)
	cmd.AddCommand({{$prefix}}NewSchedulePauseCmd(c))
	cmd.AddCommand({{$prefix}}NewScheduleUnpauseCmd(c))
	cmd.AddCommand({{$prefix}}NewScheduleDeleteCmd(c))
	cmd.AddCommand({{$prefix}}NewScheduleDescribeCmd(c))
	return cmd
}

{{- range .Workflows}}
{{- if .InputFlagPlan}}
{{- $wf := .}}
{{- $plan := .InputFlagPlan}}
{{- $wfKebab := .GoName | kebab}}

// {{$prefix}}New{{.GoName}}StartCmd returns `workflow start {{$wfKebab}}`.
// It populates {{QualifiedGoIdent .Input.GoIdent}} from flags and invokes
// ExecuteWorkflow{{.GoName}}, printing workflow and run ids on success.
func {{$prefix}}New{{.GoName}}StartCmd(c {{TemporalClient "Client"}}) *{{Cobra "Command"}} {
	var workflowID string
	req := &{{QualifiedGoIdent .Input.GoIdent}}{}
{{- range $plan.Flags}}
	{{cliVarDecl . $prefix}}
{{- end}}
	cmd := &{{Cobra "Command"}}{
		Use:   {{Quote $wfKebab}},
		Short: "Start workflow {{.GoName}}",
		Long:  {{Quote (printf "Start workflow %s asynchronously and print the workflow/run ids." .GoName)}} + {{$prefix}}OneofLong({{oneofGroupsGoLiteral $plan.OneofGroups}}),
		RunE: func(cmd *{{Cobra "Command"}}, args []string) error {
{{- range $plan.Flags}}
			if cmd.Flags().Changed({{Quote .CLIName}}) {
				{{cliApplyBlock . $prefix}}
			}
{{- end}}
			svc, err := New{{$svc.GetClientName}}(c)
			if err != nil {
				return err
			}
			opts := {{TemporalClient "StartWorkflowOptions"}}{ID: workflowID}
			run, err := svc.ExecuteWorkflow{{.GoName}}(cmd.Context(), req, opts)
			if err != nil {
				return err
			}
			{{Fmt "Fprintf"}}(cmd.OutOrStdout(), "workflow-id: %s\nrun-id: %s\n", run.GetID(), run.GetRunID())
			return nil
		},
	}
	cmd.Flags().StringVar(&workflowID, "workflow-id", "", "Workflow ID. Optional; a UUID-suffixed id is generated when empty.")
{{- range $plan.Flags}}
	{{cliRegisterLine . $prefix}}
{{- end}}
	{{oneofExclusiveCalls $plan.OneofGroups}}
	return cmd
}

// {{$prefix}}New{{.GoName}}ExecuteCmd returns `workflow execute {{$wfKebab}}`.
// It starts the workflow, blocks on the result, and prints a
// JSON-encoded {{QualifiedGoIdent .Output.GoIdent}}.
func {{$prefix}}New{{.GoName}}ExecuteCmd(c {{TemporalClient "Client"}}) *{{Cobra "Command"}} {
	var workflowID string
	req := &{{QualifiedGoIdent .Input.GoIdent}}{}
{{- range $plan.Flags}}
	{{cliVarDecl . $prefix}}
{{- end}}
	cmd := &{{Cobra "Command"}}{
		Use:   {{Quote $wfKebab}},
		Short: "Execute workflow {{.GoName}} and wait for the result",
		Long:  {{Quote (printf "Execute workflow %s synchronously and print its JSON-encoded result." .GoName)}} + {{$prefix}}OneofLong({{oneofGroupsGoLiteral $plan.OneofGroups}}),
		RunE: func(cmd *{{Cobra "Command"}}, args []string) error {
{{- range $plan.Flags}}
			if cmd.Flags().Changed({{Quote .CLIName}}) {
				{{cliApplyBlock . $prefix}}
			}
{{- end}}
			svc, err := New{{$svc.GetClientName}}(c)
			if err != nil {
				return err
			}
			opts := {{TemporalClient "StartWorkflowOptions"}}{ID: workflowID}
			resp, err := svc.ExecuteWorkflow{{.GoName}}Sync(cmd.Context(), req, opts)
			if err != nil {
				return err
			}
			return {{$prefix}}PrintJSON(cmd.OutOrStdout(), resp)
		},
	}
	cmd.Flags().StringVar(&workflowID, "workflow-id", "", "Workflow ID. Optional; a UUID-suffixed id is generated when empty.")
{{- range $plan.Flags}}
	{{cliRegisterLine . $prefix}}
{{- end}}
	{{oneofExclusiveCalls $plan.OneofGroups}}
	return cmd
}

{{- range .Options.Signals}}
{{- $sig := index $svc.SignalsMap .}}
{{- if $sig}}
{{- $sigPlan := $sig.InputFlagPlan}}
{{- $sigKebab := $sig.GoName | kebab}}

