// {{$prefix}}PrintJSON marshals m via protojson with indent and writes it
// to w followed by a newline.
func {{$prefix}}PrintJSON(w {{IO "Writer"}}, m {{Proto "Message"}}) error {
	opts := {{Protojson "MarshalOptions"}}{Multiline: true, Indent: "  "}
	out, err := opts.Marshal(m)
	if err != nil {
		return err
	}
	_, err = w.Write(append(out, '\n'))
	return err
}

// {{$prefix}}OneofLong renders the mutually-exclusive oneof groups as a
// trailing block appended to a command's Long description.
func {{$prefix}}OneofLong(groups [][]string) string {
	if len(groups) == 0 {
		return ""
	}
	var b {{Strings "Builder"}}
	b.WriteString("\n\nMutually exclusive flag groups:\n")
	for _, g := range groups {
		b.WriteString("  ")
		for i, name := range g {
			if i > 0 {
				b.WriteString(", ")
			}
			b.WriteString("--")
			b.WriteString(name)
		}
		b.WriteString("\n")
	}
	return b.String()
}

// {{$prefix}}SetField walks a proto field path from the root message,
// allocating intermediate message pointers as needed, and assigns value
// to the leaf field.
func {{$prefix}}SetField(root {{Proto "Message"}}, path []string, value interface{}) error {
	cur := {{Reflect "ValueOf"}}(root)
	if cur.Kind() != {{Reflect "Ptr"}} || cur.IsNil() {
		return {{Errors "New"}}("SetField: root must be a non-nil pointer")
	}
	cur = cur.Elem()
	for i, seg := range path {
		fieldName := {{$prefix}}GoFieldName(seg)
		f := cur.FieldByName(fieldName)
		if !f.IsValid() {
			return {{Fmt "Errorf"}}("SetField: no field %q on %s", fieldName, cur.Type())
		}
		if i == len(path)-1 {
			return {{$prefix}}AssignField(f, value)
		}
		if f.Kind() == {{Reflect "Ptr"}} {
			if f.IsNil() {
				f.Set({{Reflect "New"}}(f.Type().Elem()))
			}
			cur = f.Elem()
		} else {
			cur = f
		}
	}
	return nil
}

// {{$prefix}}AssignField assigns value to dst, handling pointer-to-scalar
// (proto3 optional / wrapper) destinations and numeric conversion for
// enum fields. When dst is a pointer to a WKT wrapper message (one with
// a single exported `Value` field carrying the scalar payload), the
// source scalar is written into that field rather than onto the struct
// whole.
func {{$prefix}}AssignField(dst {{Reflect "Value"}}, value interface{}) error {
	v := {{Reflect "ValueOf"}}(value)
	if dst.Kind() == {{Reflect "Ptr"}} {
		if v.Kind() == {{Reflect "Ptr"}} {
			if v.Type().AssignableTo(dst.Type()) {
				dst.Set(v)
				return nil
			}
		}
		p := {{Reflect "New"}}(dst.Type().Elem())
		pv := p.Elem()
		if v.Type().AssignableTo(pv.Type()) {
			pv.Set(v)
			dst.Set(p)
			return nil
		}
		if v.Type().ConvertibleTo(pv.Type()) {
			pv.Set(v.Convert(pv.Type()))
			dst.Set(p)
			return nil
		}
		// WKT wrapper: struct has a single exported Value field whose
		// type matches (or is convertible from) the source.
		if pv.Kind() == {{Reflect "Struct"}} {
			if inner := pv.FieldByName("Value"); inner.IsValid() && inner.CanSet() {
				if v.Type().AssignableTo(inner.Type()) {
					inner.Set(v)
					dst.Set(p)
					return nil
				}
				if v.Type().ConvertibleTo(inner.Type()) {
					inner.Set(v.Convert(inner.Type()))
					dst.Set(p)
					return nil
				}
			}
		}
		return {{Fmt "Errorf"}}("cannot assign %s to *%s", v.Type(), pv.Type())
	}
	if v.Type().AssignableTo(dst.Type()) {
		dst.Set(v)
		return nil
	}
	if v.Type().ConvertibleTo(dst.Type()) {
		dst.Set(v.Convert(dst.Type()))
		return nil
	}
	return {{Fmt "Errorf"}}("cannot assign %s to %s", v.Type(), dst.Type())
}

// {{$prefix}}UnmarshalJSONInto locates the leaf message field addressed
// by path, allocates a fresh message of its element type (or element of
// the slice for repeated fields), and protojson-unmarshals raw into it.
// For repeated-message fields the raw input must be a JSON array;
// individual elements are unmarshaled one-by-one into the slice.
func {{$prefix}}UnmarshalJSONInto(root {{Proto "Message"}}, path []string, raw string) error {
	cur := {{Reflect "ValueOf"}}(root)
	if cur.Kind() != {{Reflect "Ptr"}} || cur.IsNil() {
		return {{Errors "New"}}("UnmarshalJSONInto: root must be a non-nil pointer")
	}
	cur = cur.Elem()
	for i, seg := range path {
		fieldName := {{$prefix}}GoFieldName(seg)
		f := cur.FieldByName(fieldName)
		if !f.IsValid() {
			return {{Fmt "Errorf"}}("UnmarshalJSONInto: no field %q on %s", fieldName, cur.Type())
		}
		if i == len(path)-1 {
			return {{$prefix}}UnmarshalLeaf(f, raw)
		}
		if f.Kind() == {{Reflect "Ptr"}} {
			if f.IsNil() {
				f.Set({{Reflect "New"}}(f.Type().Elem()))
			}
			cur = f.Elem()
			continue
		}
		cur = f
	}
	return nil
}

// {{$prefix}}UnmarshalLeaf handles the terminal JSON-escape assignment
// for three shapes: a pointer to a proto message, a slice of pointers to
// proto messages, and a map whose element is a proto message.
func {{$prefix}}UnmarshalLeaf(dst {{Reflect "Value"}}, raw string) error {
	unmarshalOne := func(target {{Reflect "Value"}}) error {
		m, ok := target.Interface().({{Proto "Message"}})
		if !ok {
			return {{Fmt "Errorf"}}("JSON target %s is not a proto.Message", target.Type())
		}
		return {{Protojson "Unmarshal"}}([]byte(raw), m)
	}
	switch dst.Kind() {
	case {{Reflect "Ptr"}}:
		if dst.IsNil() {
			dst.Set({{Reflect "New"}}(dst.Type().Elem()))
		}
		return unmarshalOne(dst)
	case {{Reflect "Slice"}}:
		elemType := dst.Type().Elem()
		// Parse the incoming raw JSON array via encoding/json into
		// json.RawMessage elements; unmarshal each element with protojson
		// into a fresh instance of the slice's element type.
		var arr []{{EncodingJSON "RawMessage"}}
		if err := {{EncodingJSON "Unmarshal"}}([]byte(raw), &arr); err != nil {
			return {{Fmt "Errorf"}}("invalid JSON array: %w", err)
		}
		slice := {{Reflect "MakeSlice"}}(dst.Type(), 0, len(arr))
		for _, elemRaw := range arr {
			if elemType.Kind() == {{Reflect "Ptr"}} {
				p := {{Reflect "New"}}(elemType.Elem())
				m, ok := p.Interface().({{Proto "Message"}})
				if !ok {
					return {{Fmt "Errorf"}}("slice element %s is not a proto.Message", elemType)
				}
				if err := {{Protojson "Unmarshal"}}([]byte(elemRaw), m); err != nil {
					return err
				}
				slice = {{Reflect "Append"}}(slice, p)
			} else {
				v := {{Reflect "New"}}(elemType).Elem()
				if err := {{EncodingJSON "Unmarshal"}}([]byte(elemRaw), v.Addr().Interface()); err != nil {
					return err
				}
				slice = {{Reflect "Append"}}(slice, v)
			}
		}
		dst.Set(slice)
		return nil
	case {{Reflect "Map"}}:
		// For maps we fall back to encoding/json; a map<string, proto> is
		// unmarshaled via a temporary map[string]json.RawMessage and each
		// value is protojson-unmarshaled into an allocated element.
		keyType := dst.Type().Key()
		elemType := dst.Type().Elem()
		if keyType.Kind() != {{Reflect "String"}} {
			return {{Fmt "Errorf"}}("map with non-string key %s cannot be JSON-loaded", keyType)
		}
		var tmp map[string]{{EncodingJSON "RawMessage"}}
		if err := {{EncodingJSON "Unmarshal"}}([]byte(raw), &tmp); err != nil {
			return {{Fmt "Errorf"}}("invalid JSON object: %w", err)
		}
		out := {{Reflect "MakeMapWithSize"}}(dst.Type(), len(tmp))
		for k, elemRaw := range tmp {
			if elemType.Kind() == {{Reflect "Ptr"}} {
				p := {{Reflect "New"}}(elemType.Elem())
				m, ok := p.Interface().({{Proto "Message"}})
				if !ok {
					return {{Fmt "Errorf"}}("map value %s is not a proto.Message", elemType)
				}
				if err := {{Protojson "Unmarshal"}}([]byte(elemRaw), m); err != nil {
					return err
				}
				out.SetMapIndex({{Reflect "ValueOf"}}(k), p)
			} else {
				v := {{Reflect "New"}}(elemType).Elem()
				if err := {{EncodingJSON "Unmarshal"}}([]byte(elemRaw), v.Addr().Interface()); err != nil {
					return err
				}
				out.SetMapIndex({{Reflect "ValueOf"}}(k), v)
			}
		}
		dst.Set(out)
		return nil
	default:
		// Scalar JSON target (e.g. a cyclic scalar) — fall back to
		// encoding/json into an addressable copy, then assign.
		v := {{Reflect "New"}}(dst.Type()).Elem()
		if err := {{EncodingJSON "Unmarshal"}}([]byte(raw), v.Addr().Interface()); err != nil {
			return err
		}
		dst.Set(v)
		return nil
	}
}

