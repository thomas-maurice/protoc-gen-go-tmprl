// {{$prefix}}New{{.GoName}}ScheduleCreateCmd returns the
// `schedule create {{$wfKebab}}` command. Workflow input flags populate
// the request; --schedule-* flags configure the schedule.
func {{$prefix}}New{{.GoName}}ScheduleCreateCmd(c {{TemporalClient "Client"}}) *{{Cobra "Command"}} {
	var scheduleID string
	var scheduleCron []string
	var scheduleInterval []{{Time "Duration"}}
	var scheduleTimezone string
	var scheduleJitter {{Time "Duration"}}
	var schedulePaused bool
	var scheduleNote string
	var scheduleCatchup {{Time "Duration"}}
	var scheduleTaskQueue string
	scheduleStartAt := &{{$prefix}}TimestampValue{}
	scheduleEndAt := &{{$prefix}}TimestampValue{}
	scheduleOverlap := &{{$prefix}}OverlapValue{}
	req := &{{QualifiedGoIdent .Input.GoIdent}}{}
{{- range $plan.Flags}}
	{{cliVarDecl . $prefix}}
{{- end}}
	cmd := &{{Cobra "Command"}}{
		Use:   {{Quote $wfKebab}},
		Short: "Create a schedule for workflow {{.GoName}}",
		Long:  {{Quote (printf "Create a Temporal schedule that starts %s runs. Use --schedule-* flags to configure the schedule; the remaining flags populate the workflow input." .GoName)}} + {{$prefix}}OneofLong({{oneofGroupsGoLiteral $plan.OneofGroups}}),
		RunE: func(cmd *{{Cobra "Command"}}, args []string) error {
{{- range $plan.Flags}}
			if cmd.Flags().Changed({{Quote .CLIName}}) {
				{{cliApplyBlock . $prefix}}
			}
{{- end}}
			svc, err := New{{$svc.GetClientName}}(c, scheduleTaskQueue)
			if err != nil {
				return err
			}
			opts := {{TemporalClient "ScheduleOptions"}}{
				Spec: {{TemporalClient "ScheduleSpec"}}{
					CronExpressions: scheduleCron,
					TimeZoneName:    scheduleTimezone,
					Jitter:          scheduleJitter,
				},
				Note:          scheduleNote,
				Paused:        schedulePaused,
				CatchupWindow: scheduleCatchup,
			}
			for _, d := range scheduleInterval {
				opts.Spec.Intervals = append(opts.Spec.Intervals, {{TemporalClient "ScheduleIntervalSpec"}}{Every: d})
			}
			if scheduleStartAt.ts != nil {
				opts.Spec.StartAt = scheduleStartAt.ts.AsTime()
			}
			if scheduleEndAt.ts != nil {
				opts.Spec.EndAt = scheduleEndAt.ts.AsTime()
			}
			if scheduleOverlap.set {
				opts.Overlap = scheduleOverlap.v
			}
			handle, err := svc.CreateSchedule{{.GoName}}(cmd.Context(), scheduleID, req, opts)
			if err != nil {
				return err
			}
			{{Fmt "Fprintf"}}(cmd.OutOrStdout(), "schedule-id: %s\n", handle.GetID())
			return nil
		},
	}
	cmd.Flags().StringVar(&scheduleID, "schedule-id", "", "Schedule identifier. Required.")
	cmd.Flags().StringArrayVar(&scheduleCron, "schedule-cron", nil, "Cron expression for the schedule (repeatable flag: pass --schedule-cron once per expression).")
	cmd.Flags().DurationSliceVar(&scheduleInterval, "schedule-interval", nil, "Interval spec, e.g. 5m or 1h (repeatable flag: pass --schedule-interval once per element).")
	cmd.Flags().Var(scheduleStartAt, "schedule-start-at", "Earliest time the schedule may fire (RFC3339 timestamp, e.g. \"2025-01-02T15:04:05Z\").")
	cmd.Flags().Var(scheduleEndAt, "schedule-end-at", "Latest time the schedule may fire (RFC3339 timestamp, e.g. \"2025-01-02T15:04:05Z\").")
	cmd.Flags().StringVar(&scheduleTimezone, "schedule-timezone", "", "IANA timezone name, e.g. Europe/Paris.")
	cmd.Flags().DurationVar(&scheduleJitter, "schedule-jitter", 0, "Maximum random offset applied to each firing (Go duration, e.g. \"5m\", \"1h30m\").")
	cmd.Flags().BoolVar(&schedulePaused, "schedule-paused", false, "Create the schedule in paused state.")
	cmd.Flags().StringVar(&scheduleNote, "schedule-note", "", "Free-text note attached to the schedule state.")
	cmd.Flags().Var(scheduleOverlap, "schedule-overlap", "Overlap policy (one of: skip, buffer-one, buffer-all, cancel-other, terminate-other, allow-all; case-insensitive).")
	cmd.Flags().DurationVar(&scheduleCatchup, "schedule-catchup-window", 0, "Maximum catch-up window (Go duration, e.g. \"5m\", \"1h30m\").")
	cmd.Flags().StringVar(&scheduleTaskQueue, "schedule-task-queue", "", "Override task queue for this schedule's runs. Defaults to the service task queue.")
	_ = cmd.MarkFlagRequired("schedule-id")
{{- range $plan.Flags}}
	{{cliRegisterLine . $prefix}}
{{- end}}
	{{oneofExclusiveCalls $plan.OneofGroups}}
	return cmd
}
{{- end}}
{{- end}}

