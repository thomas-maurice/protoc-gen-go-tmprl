// SnapshotServicecliTimestampValue is a pflag.Value parsing RFC3339 / RFC3339Nano
// into a *timestamppb.Timestamp. Empty input is an error; callers
// presence-gate via cmd.Flags().Changed.
type SnapshotServicecliTimestampValue struct {
	ts *timestamppb.Timestamp
}

func (v *SnapshotServicecliTimestampValue) Set(s string) error {
	t, err := time.Parse(time.RFC3339Nano, s)
	if err != nil {
		t, err = time.Parse(time.RFC3339, s)
		if err != nil {
			return fmt.Errorf("invalid RFC3339 timestamp %q: %w", s, err)
		}
	}
	v.ts = timestamppb.New(t)
	return nil
}

func (v *SnapshotServicecliTimestampValue) String() string {
	if v == nil || v.ts == nil {
		return ""
	}
	return v.ts.AsTime().Format(time.RFC3339Nano)
}

func (v *SnapshotServicecliTimestampValue) Type() string { return "timestamp" }

// SnapshotServicecliOverlapValue is a pflag.Value for the schedule overlap
// policy. Value names are kebab-case; Set is case-insensitive.
type SnapshotServicecliOverlapValue struct {
	v   v1.ScheduleOverlapPolicy
	set bool
}

func (v *SnapshotServicecliOverlapValue) Set(s string) error {
	switch strings.ToLower(s) {
	case "skip":
		v.v = v1.SCHEDULE_OVERLAP_POLICY_SKIP
	case "buffer-one":
		v.v = v1.SCHEDULE_OVERLAP_POLICY_BUFFER_ONE
	case "buffer-all":
		v.v = v1.SCHEDULE_OVERLAP_POLICY_BUFFER_ALL
	case "cancel-other":
		v.v = v1.SCHEDULE_OVERLAP_POLICY_CANCEL_OTHER
	case "terminate-other":
		v.v = v1.SCHEDULE_OVERLAP_POLICY_TERMINATE_OTHER
	case "allow-all":
		v.v = v1.SCHEDULE_OVERLAP_POLICY_ALLOW_ALL
	default:
		return fmt.Errorf("invalid overlap %q; want one of: skip, buffer-one, buffer-all, cancel-other, terminate-other, allow-all", s)
	}
	v.set = true
	return nil
}

func (v *SnapshotServicecliOverlapValue) String() string {
	if v == nil || !v.set {
		return ""
	}
	return fmt.Sprintf("%v", v.v)
}

func (v *SnapshotServicecliOverlapValue) Type() string { return "overlap" }

// SnapshotServicecliEnumPriorityValue wraps a example.snapshot.v1.Priority enum for use as a
// pflag.Value. Set is case-insensitive and validates against the declared
// names.
type SnapshotServicecliEnumPriorityValue struct {
	v   int32
	set bool
}

func (v *SnapshotServicecliEnumPriorityValue) Set(s string) error {
	switch strings.ToUpper(strings.ReplaceAll(s, "-", "_")) {
	case "PRIORITY_UNSPECIFIED":
		v.v = 0
	case "PRIORITY_LOW":
		v.v = 1
	case "PRIORITY_HIGH":
		v.v = 2
	default:
		return fmt.Errorf("invalid value %q for enum Priority; want one of: PRIORITY_UNSPECIFIED, PRIORITY_LOW, PRIORITY_HIGH", s)
	}
	v.set = true
	return nil
}

func (v *SnapshotServicecliEnumPriorityValue) String() string {
	if v == nil || !v.set {
		return ""
	}
	return fmt.Sprintf("%d", v.v)
}

func (v *SnapshotServicecliEnumPriorityValue) Type() string { return "Priority" }

// SnapshotServicecliJSONValue is a pflag.Value that captures a raw JSON string
// at parse time; the destination proto message is unmarshaled at RunE
// time so leaving the flag unset is not an error.
type SnapshotServicecliJSONValue struct {
	raw string
	set bool
}

func (v *SnapshotServicecliJSONValue) Set(s string) error {
	v.raw = s
	v.set = true
	return nil
}

func (v *SnapshotServicecliJSONValue) String() string {
	if v == nil {
		return ""
	}
	return v.raw
}

func (v *SnapshotServicecliJSONValue) Type() string { return "json" }

// SnapshotServicecliPrintJSON marshals m via protojson with indent and writes it
// to w followed by a newline.
func SnapshotServicecliPrintJSON(w io.Writer, m proto.Message) error {
	opts := protojson.MarshalOptions{Multiline: true, Indent: "  "}
	out, err := opts.Marshal(m)
	if err != nil {
		return err
	}
	_, err = w.Write(append(out, '\n'))
	return err
}

// SnapshotServicecliOneofLong renders the mutually-exclusive oneof groups as a
// trailing block appended to a command's Long description.
func SnapshotServicecliOneofLong(groups [][]string) string {
	if len(groups) == 0 {
		return ""
	}
	var b strings.Builder
	b.WriteString("\n\nMutually exclusive flag groups:\n")
	for _, g := range groups {
		b.WriteString("  ")
		for i, name := range g {
			if i > 0 {
				b.WriteString(", ")
			}
			b.WriteString("--")
			b.WriteString(name)
		}
		b.WriteString("\n")
	}
	return b.String()
}

// SnapshotServicecliSetField walks a proto field path from the root message,
// allocating intermediate message pointers as needed, and assigns value
// to the leaf field.
func SnapshotServicecliSetField(root proto.Message, path []string, value interface{}) error {
	cur := reflect.ValueOf(root)
	if cur.Kind() != reflect.Ptr || cur.IsNil() {
		return errors.New("SetField: root must be a non-nil pointer")
	}
	cur = cur.Elem()
	for i, seg := range path {
		fieldName := SnapshotServicecliGoFieldName(seg)
		f := cur.FieldByName(fieldName)
		if !f.IsValid() {
			return fmt.Errorf("SetField: no field %q on %s", fieldName, cur.Type())
		}
		if i == len(path)-1 {
			return SnapshotServicecliAssignField(f, value)
		}
		if f.Kind() == reflect.Ptr {
			if f.IsNil() {
				f.Set(reflect.New(f.Type().Elem()))
			}
			cur = f.Elem()
		} else {
			cur = f
		}
	}
	return nil
}

// SnapshotServicecliAssignField assigns value to dst, handling pointer-to-scalar
// (proto3 optional / wrapper) destinations and numeric conversion for
// enum fields. When dst is a pointer to a WKT wrapper message (one with
// a single exported `Value` field carrying the scalar payload), the
// source scalar is written into that field rather than onto the struct
// whole.
func SnapshotServicecliAssignField(dst reflect.Value, value interface{}) error {
	v := reflect.ValueOf(value)
	if dst.Kind() == reflect.Ptr {
		if v.Kind() == reflect.Ptr {
			if v.Type().AssignableTo(dst.Type()) {
				dst.Set(v)
				return nil
			}
		}
		p := reflect.New(dst.Type().Elem())
		pv := p.Elem()
		if v.Type().AssignableTo(pv.Type()) {
			pv.Set(v)
			dst.Set(p)
			return nil
		}
		if v.Type().ConvertibleTo(pv.Type()) {
			pv.Set(v.Convert(pv.Type()))
			dst.Set(p)
			return nil
		}
		// WKT wrapper: struct has a single exported Value field whose
		// type matches (or is convertible from) the source.
		if pv.Kind() == reflect.Struct {
			if inner := pv.FieldByName("Value"); inner.IsValid() && inner.CanSet() {
				if v.Type().AssignableTo(inner.Type()) {
					inner.Set(v)
					dst.Set(p)
					return nil
				}
				if v.Type().ConvertibleTo(inner.Type()) {
					inner.Set(v.Convert(inner.Type()))
					dst.Set(p)
					return nil
				}
			}
		}
		return fmt.Errorf("cannot assign %s to *%s", v.Type(), pv.Type())
	}
	if v.Type().AssignableTo(dst.Type()) {
		dst.Set(v)
		return nil
	}
	if v.Type().ConvertibleTo(dst.Type()) {
		dst.Set(v.Convert(dst.Type()))
		return nil
	}
	return fmt.Errorf("cannot assign %s to %s", v.Type(), dst.Type())
}

// SnapshotServicecliUnmarshalJSONInto locates the leaf message field addressed
// by path, allocates a fresh message of its element type (or element of
// the slice for repeated fields), and protojson-unmarshals raw into it.
// For repeated-message fields the raw input must be a JSON array;
// individual elements are unmarshaled one-by-one into the slice.
func SnapshotServicecliUnmarshalJSONInto(root proto.Message, path []string, raw string) error {
	cur := reflect.ValueOf(root)
	if cur.Kind() != reflect.Ptr || cur.IsNil() {
		return errors.New("UnmarshalJSONInto: root must be a non-nil pointer")
	}
	cur = cur.Elem()
	for i, seg := range path {
		fieldName := SnapshotServicecliGoFieldName(seg)
		f := cur.FieldByName(fieldName)
		if !f.IsValid() {
			return fmt.Errorf("UnmarshalJSONInto: no field %q on %s", fieldName, cur.Type())
		}
		if i == len(path)-1 {
			return SnapshotServicecliUnmarshalLeaf(f, raw)
		}
		if f.Kind() == reflect.Ptr {
			if f.IsNil() {
				f.Set(reflect.New(f.Type().Elem()))
			}
			cur = f.Elem()
			continue
		}
		cur = f
	}
	return nil
}

// SnapshotServicecliUnmarshalLeaf handles the terminal JSON-escape assignment
// for three shapes: a pointer to a proto message, a slice of pointers to
// proto messages, and a map whose element is a proto message.
func SnapshotServicecliUnmarshalLeaf(dst reflect.Value, raw string) error {
	unmarshalOne := func(target reflect.Value) error {
		m, ok := target.Interface().(proto.Message)
		if !ok {
			return fmt.Errorf("JSON target %s is not a proto.Message", target.Type())
		}
		return protojson.Unmarshal([]byte(raw), m)
	}
	switch dst.Kind() {
	case reflect.Ptr:
		if dst.IsNil() {
			dst.Set(reflect.New(dst.Type().Elem()))
		}
		return unmarshalOne(dst)
	case reflect.Slice:
		elemType := dst.Type().Elem()
		// Parse the incoming raw JSON array via encoding/json into
		// json.RawMessage elements; unmarshal each element with protojson
		// into a fresh instance of the slice's element type.
		var arr []json.RawMessage
		if err := json.Unmarshal([]byte(raw), &arr); err != nil {
			return fmt.Errorf("invalid JSON array: %w", err)
		}
		slice := reflect.MakeSlice(dst.Type(), 0, len(arr))
		for _, elemRaw := range arr {
			if elemType.Kind() == reflect.Ptr {
				p := reflect.New(elemType.Elem())
				m, ok := p.Interface().(proto.Message)
				if !ok {
					return fmt.Errorf("slice element %s is not a proto.Message", elemType)
				}
				if err := protojson.Unmarshal([]byte(elemRaw), m); err != nil {
					return err
				}
				slice = reflect.Append(slice, p)
			} else {
				v := reflect.New(elemType).Elem()
				if err := json.Unmarshal([]byte(elemRaw), v.Addr().Interface()); err != nil {
					return err
				}
				slice = reflect.Append(slice, v)
			}
		}
		dst.Set(slice)
		return nil
	case reflect.Map:
		// For maps we fall back to encoding/json; a map<string, proto> is
		// unmarshaled via a temporary map[string]json.RawMessage and each
		// value is protojson-unmarshaled into an allocated element.
		keyType := dst.Type().Key()
		elemType := dst.Type().Elem()
		if keyType.Kind() != reflect.String {
			return fmt.Errorf("map with non-string key %s cannot be JSON-loaded", keyType)
		}
		var tmp map[string]json.RawMessage
		if err := json.Unmarshal([]byte(raw), &tmp); err != nil {
			return fmt.Errorf("invalid JSON object: %w", err)
		}
		out := reflect.MakeMapWithSize(dst.Type(), len(tmp))
		for k, elemRaw := range tmp {
			if elemType.Kind() == reflect.Ptr {
				p := reflect.New(elemType.Elem())
				m, ok := p.Interface().(proto.Message)
				if !ok {
					return fmt.Errorf("map value %s is not a proto.Message", elemType)
				}
				if err := protojson.Unmarshal([]byte(elemRaw), m); err != nil {
					return err
				}
				out.SetMapIndex(reflect.ValueOf(k), p)
			} else {
				v := reflect.New(elemType).Elem()
				if err := json.Unmarshal([]byte(elemRaw), v.Addr().Interface()); err != nil {
					return err
				}
				out.SetMapIndex(reflect.ValueOf(k), v)
			}
		}
		dst.Set(out)
		return nil
	default:
		// Scalar JSON target (e.g. a cyclic scalar) — fall back to
		// encoding/json into an addressable copy, then assign.
		v := reflect.New(dst.Type()).Elem()
		if err := json.Unmarshal([]byte(raw), v.Addr().Interface()); err != nil {
			return err
		}
		dst.Set(v)
		return nil
	}
}

// SnapshotServicecliDurationProto converts a time.Duration into a
// *durationpb.Duration for assignment into a proto message field.
func SnapshotServicecliDurationProto(d time.Duration) *durationpb.Duration {
	return durationpb.New(d)
}

// SnapshotServicecliFieldMaskProto wraps a list of path strings in a
// *fieldmaskpb.FieldMask. A nil/empty input yields an empty mask.
func SnapshotServicecliFieldMaskProto(paths []string) *fieldmaskpb.FieldMask {
	return &fieldmaskpb.FieldMask{Paths: paths}
}

// SnapshotServicecliGoFieldName mirrors protoc-gen-go's snake_case -> UpperCamel
// conversion for reflective struct-field lookup.
func SnapshotServicecliGoFieldName(snake string) string {
	if snake == "" {
		return ""
	}
	upperNext := true
	out := make([]rune, 0, len(snake))
	for _, r := range snake {
		if r == '_' {
			upperNext = true
			continue
		}
		if upperNext {
			if r >= 'a' && r <= 'z' {
				r -= 'a' - 'A'
			}
			upperNext = false
		}
		out = append(out, r)
	}
	return string(out)
}
