		RunE: func(cmd *cobra.Command, args []string) error {
			resp, err := c.DescribeWorkflowExecution(cmd.Context(), workflowID, runID)
			if err != nil {
				return err
			}
			out, err := json.MarshalIndent(resp, "", "  ")
			if err != nil {
				return err
			}
			fmt.Fprintln(cmd.OutOrStdout(), string(out))
			return nil
		},
	}
	cmd.Flags().StringVar(&workflowID, "workflow-id", "", "Workflow ID of the target run. Required.")
	cmd.Flags().StringVar(&runID, "run-id", "", "Run ID of the target run. Optional; empty targets the latest run.")
	_ = cmd.MarkFlagRequired("workflow-id")
	return cmd
}

